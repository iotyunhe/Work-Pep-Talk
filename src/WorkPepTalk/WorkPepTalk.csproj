<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!--
      刻意不引 WinForms。托盘改用 Interop/Shell.cs 里手写的 Shell_NotifyIcon +
      原生菜单：为了 WinForms 的 NotifyIcon 要背上 18MB 的 WinForms 栈，
      自包含单文件压缩后仍占 6.5MB（占整个 exe 一成），而实际只用到「放个图标」。
    -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WorkPepTalk</AssemblyName>
    <RootNamespace>WorkPepTalk</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>上班鼓励器</Product>
    <Company>Work-Pep-Talk</Company>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- exe 资源里的图标：资源管理器、任务栏、快捷方式都读这一份 -->
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <!-- 绿色版：不生成 pdb 附带文件，单文件发布见 publish.ps1 -->
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!--
    图标同时要以 WPF 资源形式打进程序集：托盘和窗口图标运行时要拿到它，
    不能再去磁盘上找文件。
  -->
  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="Assets\app.ico" />
  </ItemGroup>

  <!--
    界面是 exe 里的一部分，不再依赖旁边的 wwwroot 目录 ——
    这样发布出去可以只有一个 exe，拷到别人机器上直接双击。
    逻辑名统一成 web/xxx，宿主按请求路径从资源流里取。
  -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*.*">
      <LogicalName>web/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    发布期剔重。自包含发布会把一批「只在调试期、设计器、或某个我们用不到的宿主
    里才加载」的程序集一起塞进 exe，对一个绿色小挂件纯属白扛。

      System.Windows.Forms 及其家属   18MB   已改手写 Shell_NotifyIcon，运行时零引用
        （注意：Microsoft.Web.WebView2 包里带了 WinForms 宿主程序集，
          它会把整个 WinForms 栈反向拖进发布清单，所以连它一起剔）
      System.Drawing.Common / Design  1.5MB  Bitmap/Graphics，图标改走 .ico + HICON 后不用了
      System.Windows.Forms.Design     5.3MB  WinForms 设计器
      System.Windows.Controls.Ribbon  1.4MB  WPF Ribbon 控件，界面在 WebView2 里
      ReachFramework.dll              1.5MB  XPS 打印/文档栈，挂件不打印
      Microsoft.DiaSymReader.Native   2.1MB  读 PDB 符号，Release 不出 pdb
      mscordaccore / mscordbi         2.5MB  调试器与内存转储分析接口

    System.Drawing.Primitives 必须留着：WebView2 的 DefaultBackgroundColor
    要 System.Drawing.Color，它就在这个 100KB 的小程序集里。

    再往下就不砍了：System.Private.Xml(7.6MB) 是 XAML 解析的根依赖，删了起不来；
    其余 BCL 大件被 WebView2 或 JSON 序列化间接引用，属于猜测性删除，
    踩中要等用户某次点操作才炸，风险换不来几百 KB。
  -->
  <Target Name="TrimPublishPayload" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)',
                        '^(System\.Windows\.Forms(\.(Primitives|Design))?|Microsoft\.VisualBasic\.Forms|WindowsFormsIntegration|Accessibility|Microsoft\.Web\.WebView2\.WinForms)$'))
                  or '%(Filename)%(Extension)' == 'System.Windows.Controls.Ribbon.dll'
                  or '%(Filename)%(Extension)' == 'ReachFramework.dll'
                  or '%(Filename)%(Extension)' == 'Microsoft.DiaSymReader.Native.amd64.dll'
                  or $([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^mscordaccore'))
                  or '%(Filename)' == 'mscordbi'" />
    </ItemGroup>
  </Target>

</Project>
